#!/usr/bin/env bash
#
# ЗАГОТОВКА, НЕ РАБОЧИЙ ХУК.
#
# Файл называется pre-commit.sample, поэтому git его не запускает. Рабочий хук
# (файл pre-commit + исполняемый бит + git config core.hooksPath .githooks)
# вы делаете в упражнении 1.17 — заготовка нужна только чтобы было с чего начать.
#
# Что должно быть в готовом хуке:
#   1) проверка staged-изменений на секреты:
#      gitleaks protect --staged, если gitleaks установлен;
#      если нет — регулярки на sk-…, AKIA…, -----BEGIN … PRIVATE KEY-----,
#      password=, token=;
#   2) php -l на изменённых .php-файлах;
#   3) понятное сообщение при срабатывании: что нашли, где, как починить;
#   4) выход с кодом 1, чтобы коммит не прошёл.

set -euo pipefail

echo "[pre-commit] Это заготовка из .githooks/pre-commit.sample, проверки не реализованы."
echo "[pre-commit] Сделайте рабочий хук в упражнении 1.17."

# Список файлов в индексе — с него удобно начинать:
# STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# TODO 1.17: проверка на секреты
# TODO 1.17: php -l по изменённым .php
# TODO 1.17: exit 1 при находке

exit 0
